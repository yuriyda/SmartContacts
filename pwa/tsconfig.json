{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": ["../shared/src/*"],
      "@smart-contacts/shared": ["../shared/src/index.ts"],
      "@smart-contacts/shared/*": ["../shared/*"],
      "@smart-contacts/web": ["../web/src/index.ts"],
      "@smart-contacts/web/*": ["../web/src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../shared" },
    { "path": "../web" }
  ]
}
